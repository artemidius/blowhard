CREATE TABLE document_extraction (
    document_id TEXT NOT NULL PRIMARY KEY REFERENCES document(id) ON DELETE CASCADE,
    processor TEXT NOT NULL CHECK(length(trim(processor)) > 0 AND length(processor) <= 128),
    processed_at_epoch_ms INTEGER NOT NULL CHECK(processed_at_epoch_ms >= 0)
);

CREATE TABLE document_extraction_page (
    document_id TEXT NOT NULL REFERENCES document_extraction(document_id) ON DELETE CASCADE,
    page_index INTEGER NOT NULL CHECK(page_index >= 0),
    markdown TEXT NOT NULL,
    PRIMARY KEY(document_id, page_index)
);

CREATE INDEX document_extraction_page_by_source
ON document_extraction_page(document_id, page_index ASC);

sourceExists:
SELECT EXISTS(SELECT 1 FROM document WHERE id = ?);

findSource:
SELECT id, display_name, size_bytes, imported_at_epoch_ms, format, page_count, width_pixels, height_pixels, content
FROM document
WHERE id = ?;

insertExtraction:
INSERT INTO document_extraction(document_id, processor, processed_at_epoch_ms)
VALUES (?, ?, ?);

insertExtractionPage:
INSERT INTO document_extraction_page(document_id, page_index, markdown)
VALUES (?, ?, ?);

findExtraction:
SELECT document_id, processor, processed_at_epoch_ms
FROM document_extraction
WHERE document_id = ?;

findExtractionPages:
SELECT page_index, markdown
FROM document_extraction_page
WHERE document_id = ?
ORDER BY page_index ASC;

deleteExtractionPages:
DELETE FROM document_extraction_page
WHERE document_id = ?;

deleteExtraction:
DELETE FROM document_extraction
WHERE document_id = ?;
