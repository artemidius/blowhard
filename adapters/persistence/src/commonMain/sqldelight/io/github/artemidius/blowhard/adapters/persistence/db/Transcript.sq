CREATE TABLE message (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL REFERENCES conversation(id) ON DELETE CASCADE,
    sequence_number INTEGER NOT NULL CHECK(sequence_number >= 0),
    role TEXT NOT NULL CHECK(role IN ('USER', 'ASSISTANT')),
    text_content TEXT NOT NULL,
    created_at_epoch_ms INTEGER NOT NULL CHECK(created_at_epoch_ms >= 0),
    UNIQUE(conversation_id, sequence_number)
);

CREATE INDEX message_by_conversation_sequence
ON message(conversation_id, sequence_number ASC);

CREATE TABLE generation_attempt (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL REFERENCES conversation(id) ON DELETE CASCADE,
    user_message_id TEXT NOT NULL REFERENCES message(id),
    assistant_message_id TEXT NOT NULL REFERENCES message(id),
    source TEXT NOT NULL CHECK(source IN ('DEMO', 'LIVE')),
    model_id TEXT,
    max_output_tokens INTEGER,
    temperature REAL,
    status TEXT NOT NULL CHECK(status IN ('QUEUED', 'RUNNING', 'SUCCEEDED', 'FAILED', 'CANCELLED', 'INTERRUPTED')),
    failure_kind TEXT,
    failure_reference TEXT,
    retry_advice TEXT,
    retry_after_seconds INTEGER,
    created_at_epoch_ms INTEGER NOT NULL CHECK(created_at_epoch_ms >= 0),
    updated_at_epoch_ms INTEGER NOT NULL CHECK(updated_at_epoch_ms >= created_at_epoch_ms),
    CHECK((source = 'DEMO' AND model_id IS NULL) OR (source = 'LIVE' AND length(trim(model_id)) > 0)),
    CHECK(max_output_tokens IS NULL OR max_output_tokens BETWEEN 1 AND 1000000),
    CHECK(temperature IS NULL OR temperature BETWEEN 0.0 AND 0.7),
    CHECK(
        (status = 'FAILED' AND failure_kind IS NOT NULL AND retry_advice IS NOT NULL) OR
        (status != 'FAILED' AND failure_kind IS NULL AND failure_reference IS NULL AND
            retry_advice IS NULL AND retry_after_seconds IS NULL)
    ),
    CHECK(retry_after_seconds IS NULL OR (retry_after_seconds >= 0 AND retry_advice = 'RETRY_AFTER_DELAY')),
    UNIQUE(conversation_id, user_message_id),
    UNIQUE(conversation_id, assistant_message_id)
);

CREATE INDEX attempt_by_conversation_creation
ON generation_attempt(conversation_id, created_at_epoch_ms ASC, id ASC);

insertMessage:
INSERT INTO message(
    id,
    conversation_id,
    sequence_number,
    role,
    text_content,
    created_at_epoch_ms
)
VALUES (?, ?, ?, ?, ?, ?);

insertAttempt:
INSERT INTO generation_attempt(
    id,
    conversation_id,
    user_message_id,
    assistant_message_id,
    source,
    model_id,
    max_output_tokens,
    temperature,
    status,
    failure_kind,
    failure_reference,
    retry_advice,
    retry_after_seconds,
    created_at_epoch_ms,
    updated_at_epoch_ms
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

listMessages:
SELECT *
FROM message
WHERE conversation_id = ?
ORDER BY sequence_number ASC;

listAttempts:
SELECT *
FROM generation_attempt
WHERE conversation_id = ?
ORDER BY created_at_epoch_ms ASC, id ASC;

interruptInFlightAttempts:
UPDATE generation_attempt
SET
    status = 'INTERRUPTED',
    updated_at_epoch_ms = CASE
        WHEN updated_at_epoch_ms > :recovered_at_epoch_ms THEN updated_at_epoch_ms
        ELSE :recovered_at_epoch_ms
    END
WHERE status IN ('QUEUED', 'RUNNING');

deleteAttempts:
DELETE FROM generation_attempt
WHERE conversation_id = ?;

deleteMessages:
DELETE FROM message
WHERE conversation_id = ?;
