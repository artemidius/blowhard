CREATE TABLE meeting_note (
    id TEXT NOT NULL PRIMARY KEY,
    document_id TEXT NOT NULL REFERENCES document(id) ON DELETE CASCADE,
    template_version TEXT NOT NULL CHECK(length(trim(template_version)) > 0 AND length(template_version) <= 128),
    model_id TEXT NOT NULL CHECK(length(trim(model_id)) > 0 AND length(model_id) <= 256),
    generated_json TEXT NOT NULL CHECK(length(generated_json) BETWEEN 1 AND 524288),
    edited_json TEXT CHECK(edited_json IS NULL OR length(edited_json) BETWEEN 1 AND 524288),
    created_at_epoch_ms INTEGER NOT NULL CHECK(created_at_epoch_ms >= 0),
    updated_at_epoch_ms INTEGER NOT NULL CHECK(updated_at_epoch_ms >= created_at_epoch_ms),
    revision INTEGER NOT NULL CHECK(revision >= 0),
    CHECK((revision = 0 AND edited_json IS NULL) OR (revision > 0 AND edited_json IS NOT NULL))
);

CREATE INDEX meeting_note_by_source_creation
ON meeting_note(document_id, created_at_epoch_ms DESC, id ASC);

CREATE TABLE meeting_note_write_receipt (
    operation_id TEXT NOT NULL PRIMARY KEY,
    approval_id TEXT NOT NULL,
    run_id TEXT NOT NULL,
    call_id TEXT NOT NULL,
    arguments_json TEXT NOT NULL CHECK(length(arguments_json) BETWEEN 1 AND 32768),
    note_id TEXT NOT NULL UNIQUE REFERENCES meeting_note(id) ON DELETE CASCADE
);

insertMeetingNote:
INSERT INTO meeting_note(
    id,
    document_id,
    template_version,
    model_id,
    generated_json,
    edited_json,
    created_at_epoch_ms,
    updated_at_epoch_ms,
    revision
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

findMeetingNote:
SELECT id, document_id, template_version, model_id, generated_json, edited_json,
       created_at_epoch_ms, updated_at_epoch_ms, revision
FROM meeting_note
WHERE id = ?;

meetingNoteExists:
SELECT EXISTS(SELECT 1 FROM meeting_note WHERE id = ?);

updateMeetingNoteEdit:
UPDATE meeting_note
SET edited_json = ?, updated_at_epoch_ms = ?, revision = revision + 1
WHERE id = ? AND revision = ?;

deleteMeetingNotesByDocument:
DELETE FROM meeting_note
WHERE document_id = ?;

insertMeetingNoteWriteReceipt:
INSERT INTO meeting_note_write_receipt(
    operation_id, approval_id, run_id, call_id, arguments_json, note_id
) VALUES (?, ?, ?, ?, ?, ?);

findMeetingNoteWriteReceipt:
SELECT approval_id, run_id, call_id, arguments_json, note_id
FROM meeting_note_write_receipt
WHERE operation_id = ?;
